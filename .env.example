# Set real values in Netlify environment variables or an ignored local .env file.
PRIMARK_ADMIN_EMAIL=
# Unique password, at least 16 characters; never put a real password in this file.
PRIMARK_ADMIN_PASSWORD=
# Email (disabled until explicitly enabled in production). Password recovery: verified Postmark sender; Functions scope. Set separately per deploy context.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
POSTMARK_MESSAGE_STREAM=outbound
PRIMARK_APP_URL=https://primark-induction.netlify.app

# Keep disabled until Postmark sender verification and controlled delivery tests are complete.
# Notification automation also needs Live mode in Organisation > Email notifications.
PRIMARK_EMAIL_DELIVERY=disabled
